<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.sawmills.codexctl.state-cap</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec "${HOME}/.cargo/bin/codexctl" state cap --max-bytes 21474836480 --older-than-days 7 --min-free-bytes 16106127360 --reserve-bytes 1073741824 --apply</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>19</integer>
  <key>ThrottleInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>/tmp/codexctl-state-cap.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/codexctl-state-cap.error.log</string>
</dict>
</plist>
